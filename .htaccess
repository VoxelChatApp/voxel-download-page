RewriteEngine On

# Redirect /baixar, /download, /setup.exe directly to release
RewriteRule ^baixar/?$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.98/Voxel-Setup-1.0.98.exe [R=302,L]
RewriteRule ^download/?$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.98/Voxel-Setup-1.0.98.exe [R=302,L]
RewriteRule ^setup\.exe$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.98/Voxel-Setup-1.0.98.exe [R=302,L]

# Rewrite /obrigado to obrigado.html
RewriteRule ^obrigado/?$ obrigado.html [QSA,L]

# Clean URLs: if .html exists, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
