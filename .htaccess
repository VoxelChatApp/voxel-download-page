RewriteEngine On
RewriteRule ^download/linux/?$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.129/Voxel-1.0.129-amd64.deb [R=302,L]
RewriteRule ^download/linux/tar/?$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.129/Voxel-1.0.129-x64.tar.gz [R=302,L]
RewriteRule ^download/android/?$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.126/Voxel-Android-1.0.8.apk [R=302,L]

# Redirect /baixar, /download, /setup.exe directly to release
RewriteRule ^baixar/?$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.139/Voxel-Setup-1.0.139.exe [R=302,L]
RewriteRule ^download/?$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.139/Voxel-Setup-1.0.139.exe [R=302,L]
RewriteRule ^setup\.exe$ https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.139/Voxel-Setup-1.0.139.exe [R=302,L]

# Rewrite /obrigado to obrigado.html
RewriteRule ^obrigado/?$ obrigado.html [QSA,L]

# Clean URLs: if .html exists, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
