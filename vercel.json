{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download/linux",
      "destination": "https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.129/Voxel-1.0.129-amd64.deb",
      "permanent": false
    },
    {
      "source": "/download/linux/tar",
      "destination": "https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.129/Voxel-1.0.129-x64.tar.gz",
      "permanent": false
    },
    {
      "source": "/download/android",
      "destination": "https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.126/Voxel-Android-1.0.8.apk",
      "permanent": false
    },
    {
      "source": "/baixar",
      "destination": "https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.140/Voxel-Setup-1.0.140.exe",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.140/Voxel-Setup-1.0.140.exe",
      "permanent": false
    },
    {
      "source": "/setup.exe",
      "destination": "https://github.com/VoxelChatApp/voxel-download-page/releases/download/v1.0.140/Voxel-Setup-1.0.140.exe",
      "permanent": false
    },
    {
      "source": "/instagram",
      "destination": "https://instagram.com/voxelchat",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "https://instagram.com/voxelchat",
      "permanent": false
    },
    {
      "source": "/web",
      "destination": "https://app.voxelchat.com.br/",
      "permanent": false
    },
    {
      "source": "/suporte",
      "destination": "/obrigado",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/obrigado",
      "destination": "/obrigado.html"
    },
    {
      "source": "/feedback",
      "destination": "/obrigado.html"
    },
    {
      "source": "/teste",
      "destination": "/obrigado.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
